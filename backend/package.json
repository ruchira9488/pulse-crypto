{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "PulseCrypto market data gateway: Binance -> conflated, batched WebSocket fan-out",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "loadtest": "tsx scripts/load-test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "fastify": "^5.12.8",
    "ws": "^8.22.1",
    "@pulse/contracts": "*"
  }
}
