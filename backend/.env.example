# HTTP + WebSocket listen address. WebSocket endpoint is ws://<host>:<port>/ws
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Trading pairs (Binance symbols)
PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,DOGEUSDT,XRPUSDT

# "binance" (live) or "synthetic" (offline random walk, also used for stress tests)
MARKET_SOURCE=binance
SYNTHETIC_EVENTS_PER_SECOND=50
BINANCE_WS_URL=wss://stream.binance.com:9443/stream
BINANCE_REST_URL=https://api.binance.com
DEPTH_LEVELS=20

# Default emit interval per client (ms) and the range clients may request
BROADCAST_INTERVAL_MS=100
MIN_INTERVAL_MS=10
MAX_INTERVAL_MS=1000

# Slow-consumer protection
HIGH_WATER_MARK_BYTES=262144
MAX_BUFFERED_BYTES=4194304
SLOW_CONSUMER_TIMEOUT_MS=15000
HEARTBEAT_INTERVAL_MS=15000
MAX_CLIENTS=1000

META_CACHE_TTL_MS=10000
